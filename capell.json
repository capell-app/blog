{
    "manifest-version": 3,
    "name": "capell-app/blog",
    "slug": "blog",
    "displayName": "Blog",
    "kind": "package",
    "capellApiVersion": "^4.0",
    "version": "4.x-dev",
    "description": "Blog adds premium article publishing, archive pages, tag pages, article widgets, optional discovery and analytics bridges, and frontend Livewire page components to Capell.",
    "product": {
        "group": "Capell Publishing Pro",
        "tier": "premium",
        "bundle": "publishing-pro"
    },
    "namespace": "Capell\\Blog",
    "surfaces": ["admin", "frontend", "console"],
    "dependencies": {
        "requires": [
            "capell-app/admin",
            "capell-app/content-sections",
            "capell-app/core",
            "capell-app/frontend",
            "capell-app/html-cache",
            "capell-app/layout-builder",
            "capell-app/navigation",
            "capell-app/tags"
        ],
        "supports": [
            "capell-app/comments",
            "capell-app/insights",
            "capell-app/publishing-studio",
            "capell-app/site-discovery"
        ],
        "conflicts": []
    },
    "providers": {
        "metadata": [],
        "install": ["Capell\\Blog\\Providers\\ConsoleServiceProvider"],
        "runtime": ["Capell\\Blog\\Providers\\BlogServiceProvider"],
        "admin": ["Capell\\Blog\\Providers\\AdminServiceProvider"],
        "frontend": ["Capell\\Blog\\Providers\\FrontendServiceProvider"]
    },
    "contributes": [],
    "database": {
        "migrations": true,
        "settings": false,
        "requiredTables": []
    },
    "commands": {
        "install": "capell:blog-install",
        "setup": "capell:blog-setup",
        "demo": "capell:blog-demo",
        "demoParams": ["sites", "languages", "force"],
        "doctor": null
    },
    "actions": {
        "install": "Capell\\Blog\\Actions\\InstallBlogPackageAction"
    },
    "settings": [],
    "permissions": [
        "article.view",
        "article.create",
        "article.update",
        "article.delete",
        "article.restore",
        "article.force_delete",
        "tag.view",
        "tag.create",
        "tag.update",
        "tag.delete",
        "tag.restore",
        "tag.force_delete"
    ],
    "capabilities": [
        "blog",
        "blog-admin",
        "blog-frontend",
        "blog-articles",
        "blog-archives",
        "blog-tags",
        "blog-related-widgets",
        "blog-cache-invalidation",
        "blog-publishing-studio-bridge",
        "blog-comments-bridge"
    ],
    "security": {
        "riskTier": "standard",
        "publicSurface": {
            "routeNames": [],
            "auth": "none",
            "csrfExemptRoutes": [],
            "signedRoutes": [],
            "tokenizedRoutes": [],
            "webhookRoutes": [],
            "throttledRoutes": []
        },
        "sensitiveData": {
            "encryptedFields": [],
            "hashedTokenFields": [],
            "redactedOutputClasses": [],
            "plaintextJustifications": []
        },
        "publicOutput": {
            "cacheSafe": true,
            "forbidAuthoringSurface": true,
            "forbidSecrets": true,
            "forbidPublicBladeQueries": true
        },
        "externalHttpClients": {
            "requiresTimeouts": false,
            "requiresSecretRedaction": false,
            "clients": []
        },
        "adminSurface": {
            "authorization": "permissions",
            "permissions": [
                "article.view",
                "article.create",
                "article.update",
                "article.delete",
                "article.restore",
                "article.force_delete",
                "tag.view",
                "tag.create",
                "tag.update",
                "tag.delete",
                "tag.restore",
                "tag.force_delete"
            ]
        }
    },
    "performance": {
        "frontendRenderBudgetMs": 20,
        "adminQueryBudget": 40,
        "cacheTags": ["blog"],
        "cacheSafety": {
            "cacheable": false,
            "variesBy": ["site", "locale"],
            "sensitiveOutput": false,
            "invalidationSources": [
                {
                    "model": "Capell\\Blog\\Models\\Article",
                    "events": [
                        "created",
                        "updated",
                        "deleted",
                        "restored",
                        "forceDeleted"
                    ]
                },
                {
                    "model": "Capell\\Tags\\Models\\Tag",
                    "events": ["created", "updated", "deleted"]
                }
            ],
            "queueInvalidation": true
        }
    },
    "healthChecks": [
        {
            "key": "blog.publishing-surface",
            "label": "Blog, archive, tag, and article publishing surfaces are installed",
            "class": "Capell\\Blog\\Health\\BlogHealthCheck",
            "severity": "critical",
            "surface": "admin"
        },
        {
            "key": "blog.cache-invalidation",
            "label": "Article saves clear blog content caches without clearing unrelated cache keys",
            "class": "Capell\\Blog\\Health\\BlogHealthCheck",
            "severity": "critical",
            "surface": "frontend"
        },
        {
            "key": "blog.author-related-rendering",
            "label": "Article widgets can render author and related article metadata",
            "class": "Capell\\Blog\\Health\\BlogHealthCheck",
            "severity": "warning",
            "surface": "frontend"
        },
        {
            "key": "blog.sitemap-static-export",
            "label": "Blog articles, archives, and tags contribute to sitemap and static export surfaces",
            "class": "Capell\\Blog\\Health\\BlogHealthCheck",
            "severity": "warning",
            "surface": "console"
        }
    ],
    "commercial": {
        "proposedLicense": "paid",
        "requestedCertification": "first-party",
        "supportPolicy": "capell-first-party",
        "privateDocsRequested": false
    },
    "marketplace": {
        "summary": "Publish articles, archives, tag pages, and related-article widgets with multilingual, multi-site output and optional growth bridges.",
        "screenshots": [
            {
                "path": "docs/assets/marketplace/extension-card.jpg",
                "alt": "Blog extension preview image",
                "caption": "Blog extension preview"
            },
            {
                "path": "docs/screenshots/articles-admin-index.png",
                "alt": "Articles admin index showing article publishing status and editorial controls",
                "caption": "Review the article queue, publish windows, language coverage, and status from the admin index."
            },
            {
                "path": "docs/screenshots/articles-admin-index-dark.png",
                "alt": "Articles admin index in dark mode",
                "caption": "Manage the article queue in dark mode."
            },
            {
                "path": "docs/screenshots/create-edit-article-form.png",
                "alt": "Create and edit article form with publishing, metadata, layout, media, and taxonomy fields",
                "caption": "Create or update an article with publishing windows, metadata, layout selection, media, and tags."
            },
            {
                "path": "docs/screenshots/create-edit-article-form-dark.png",
                "alt": "Create and edit article form in dark mode",
                "caption": "Edit article publishing details in dark mode."
            }
        ],
        "categories": ["admin", "console", "frontend", "publishing"]
    },
    "contributionTraceability": {
        "deferredContributions": [
            "admin-resource",
            "configurator",
            "model",
            "page-type",
            "page-variation"
        ]
    }
}
